// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output = "../generated"

    generatedFileExtension = "ts"
    importFileExtension    = "ts"
}

datasource db {
    provider = "postgresql"
}

enum GameStatus {
    IN_PROGRESS
    WON
    LOST
}

enum GameMode {
    CLASSIC
    HARDCORE
    ARTWORK
}

enum Color {
  WHITE
  BLUE
  BLACK
  RED
  GREEN
  COLORLESS
}

enum Rarity{
  COMMON
  UNCOMMON
  RARE
  MYTHIC
  SPECIAL
  BONUS
}

model User {
    id           String @id @default(cuid(2))
    username     String @unique
    passwordHash String?
    avatarKey    String?
    createdAt    DateTime @default(now())
    privateProfile  Boolean @default(false)
    sessions     GameSession[]
    authSessions AuthSession[]
    oauthAccounts OAuthAccount[]
}

model OAuthAccount {
    provider          String
    providerAccountId String
    userId            String
    user              User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@id([provider, providerAccountId])
    @@index([userId])
}

model AuthSession {
  id                String   @id      // sha256(token), hex. The raw token is never stored
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  expiresAt         DateTime          // idle expiry, pushed forward while the user is active
  absoluteExpiresAt DateTime          // hard cap, never extended
  lastSeenAt        DateTime @default(now())
  userAgent         String?
  ip                String?

  @@index([userId])
  @@index([expiresAt])
}

model GameSession {
    id        String     @id @default(cuid(2))
    createdAt DateTime   @default(now())
    status    GameStatus @default(IN_PROGRESS)

    userId String?
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    dailyGameId String
    dailyGame   DailyGame @relation(fields: [dailyGameId], references: [id], onDelete: Cascade)

    guesses Guess[]

    @@unique([userId, dailyGameId])
}

model DailyGame {
    id   String   @id @default(cuid(2))
    date DateTime @db.Date
    mode GameMode @default(CLASSIC)

    targetCardId String
    targetCard  MagicCard @relation(fields: [targetCardId], references: [oracleId])

    sessions GameSession[]

    @@unique([date, mode])
}

model MagicCard {
    oracleId      String @id
    edhrecRank    Int?
    imageUrl      String
    artUrl        String
    name          String
    manaValue     Int
    types         String[]
    supertypes    String[] // scryfall catalog endpoints lists existing supertypes
    subtypes      String[] // Split after the dash
    colorIdentity Color[]
    power         String?
    toughness     String?
    rarity        Rarity
    releaseDate   DateTime
    releaseSet    String
    releaseSetName    String

    dailyGames  DailyGame[]
    guesses     Guess[]

    @@index([edhrecRank])
}

model Guess {
    id            String @id @default(cuid(2))
    attemptNumber Int

    gameSessionId String
    gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

    guessedCardId String
    guessedCard   MagicCard @relation(fields: [guessedCardId], references: [oracleId])

    @@unique([gameSessionId, attemptNumber])
    @@unique([gameSessionId, guessedCardId])
}

model ScryfallSyncCard {
  key        String   @id
  lastSyncAt DateTime
}

model StagingOracleCard {
    oracleId      String @id
    edhrecRank    Int?
    imageUrl      String
    artUrl        String
    name          String
    manaValue     Int
    types         String[]
    supertypes    String[]
    subtypes      String[]
    colorIdentity Color[]
    power         String?
    toughness     String?
    rarity        Rarity
}

model StagingCardHistory {
    id            String @id
    oracleId      String
    releaseDate   DateTime
    releaseSet    String
    releaseSetName    String
}