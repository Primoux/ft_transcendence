// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output = "../generated"

    generatedFileExtension = "ts"
    importFileExtension    = "ts"
}

datasource db {
    provider = "postgresql"
}

enum GameStatus {
    IN_PROGRESS
    WON
    LOST
}

enum GameMode {
    CLASSIC
    HARDCORE
    ARTWORK
}

enum Rarity{
  COMMON
  UNCOMMON
  RARE
  MYTHIC
  SPECIAL
  BONUS
}

model User {
    id           String @id @default(cuid(2))
    username     String @unique
    displayName  String
    passwordHash String
    createdAt    DateTime @default(now())
    privateProfile  Boolean @default(false)

    sessions GameSession[]
}

model GameSession {
    id        String     @id @default(cuid(2))
    createdAt DateTime   @default(now())
    status    GameStatus @default(IN_PROGRESS)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    dailyGameId String
    dailyGame   DailyGame @relation(fields: [dailyGameId], references: [id], onDelete: Cascade)

    guesses Guess[]

    @@unique([userId, dailyGameId])
}

model DailyGame {
    id   String   @id @default(cuid(2))
    date DateTime @db.Date
    mode GameMode @default(CLASSIC)

    targetCardId String
    targetCard  MagicCard @relation(fields: [targetCardId], references: [id])

    sessions GameSession[]

    @@unique([date, mode])
}

model MagicCard {
    id            String @id @default(cuid(2))
    edhrecRank    Int?
    imageUrl      String
    artUrl        String
    name          String @unique
    manaValue     Int
    types         String[]
    supertypes    String[] // scryfall catalog endpoints lists existing supertypes
    subtypes      String[] // Split after the dash
    colorIdentity String[]
    power         String?
    toughness     String?
    extension     String
    rarity        Rarity
    releaseDate   DateTime
    releaseSet    String

    dailyGames  DailyGame[]
    guesses     Guess[]
}

model Guess {
    id            String @id @default(cuid(2))
    attemptNumber Int

    gameSessionId String
    gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

    guessedCardId String
    guessedCard   MagicCard @relation(fields: [guessedCardId], references: [id])
}

model CardSync {
  key        String   @id
  lastSyncAt DateTime
}