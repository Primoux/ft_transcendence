// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum GameStatus {
    IN_PROGRESS
    WON
    LOST
}

enum GameMode {
    CLASSIC
    HARDCORE
    ARTWORK
}

model User {
    id           String @id @default(cuid(2))
    username     String @unique
    displayName  String
    passwordHash String
    createdAt    DateTime @default(now())

    sessions GameSession[]
    comments Comment[]
}

model GameSession {
    id        String     @id @default(cuid(2))
    createdAt DateTime   @default(now())
    status    GameStatus @default(IN_PROGRESS)

    userId String
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    dailyGameId String
    dailyGame   DailyGame @relation(fields: [dailyGameId], references: [id], onDelete: Cascade)

    guesses Guess[]

    @@unique([userId, dailyGameId])
}

model DailyGame {
    id   String   @id @default(cuid(2))
    date DateTime @db.Date
    mode GameMode @default(CLASSIC)

    targetCardId String
    targetCard  MagicCard @relation(fields: [targetCardId], references: [id])

    sessions GameSession[]
    comments Comment[]

    @@unique([date, mode])
}

model MagicCard {
    id         String @id @default(cuid(2))
    name       String
    attributes Json

    dailyGames  DailyGame[]
    guesses Guess[]
}

model Guess {
    id            String @id @default(cuid(2))
    attemptNumber Int

    gameSessionId String
    gameSession   GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

    guessedCardId String
    guessedCard   MagicCard @relation(fields: [guessedCardId], references: [id])
}

model Comment {
    id        String   @id @default(cuid(2))
    content   String   @db.Text
    createdAt DateTime @default(now())
    isEdited  Boolean  @default(false)

    authorId String
    author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

    dailyGameId String
    dailyGame   DailyGame @relation(fields: [dailyGameId], references: [id], onDelete: Cascade)

    parentId String?
    parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
    replies  Comment[] @relation("CommentReplies")
}

